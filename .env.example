# Salin ke .env.local lalu isi dengan nilai dari Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key
# Hanya dipakai skrip seed di server/lokal. Jangan beri awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key
